# Environment for the backend (docker-compose.yml): the API, its Postgres and the backup job read it.
# Copy to .env for local runs, or paste the same names into Dokploy's Environment tab.
# Every value here is a secret or a deployment setting. Never commit a filled-in .env.

# ---- API (apps/api) ----------------------------------------------------------
# Port inside the container. The image and compose file expect 3000.
PORT=3000
# Public host of the link site and App Links (no scheme). Empty value: custom-scheme links only.
BASE_URL=studify.vendua.com.br
# Optional. Where /download redirects. Default: the newest GitHub Release's studify.apk.
# APK_URL=
# Optional. The built web dashboard served at /painel. The image sets it; locally the default is apps/dashboard/dist.
# DASHBOARD_DIR=

# ---- Supabase Auth (accounts only; ADR 0012) ----------------------------------
# Data, files and realtime are Studify's own; Supabase keeps only the accounts (sign-in codes, Google, sessions).
# Project URL, for example https://<project-ref>.supabase.co (Project Settings > API).
SUPABASE_URL=
# Secret key (sb_secret_...; the legacy service_role key also works until it is turned off). Server only: the API
# uses it for account administration (suspend, sign out, delete). Never ship it to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_...). Public; the web dashboard's sign-in page receives it.
SUPABASE_ANON_KEY=

# ---- Postgres (the db service of docker-compose.yml) ---------------------------
# Password of the studify database user. Letters and digits only (it goes into a connection URL), for example
# the output of `openssl rand -hex 24`. Set it once: the database keeps the password it was created with.
POSTGRES_PASSWORD=
# The compose file builds DATABASE_URL from POSTGRES_PASSWORD (postgresql://studify:<password>@db:5432/studify).
# Set it here only for a local run outside Docker, e.g. postgresql://postgres:postgres@localhost:5432/studify.
# DATABASE_URL=
# Days of nightly backups kept in the backups volume (pg_dump + a tarball of the files). Default 7.
# BACKUP_KEEP_DAYS=7

# ---- Files (stored on the API's disk) ------------------------------------------
# Signs the file links the app opens (at least 32 characters, e.g. `openssl rand -hex 32`). Changing it ends the
# links already handed out (they last an hour). Required.
STORAGE_SIGNING_KEY=
# Where the files live. The compose file mounts the files volume at /data/storage. Local runs: any directory.
# STORAGE_DIR=/data/storage
# Public base of the API that file links start with. Default https://<BASE_URL>/api.
# PUBLIC_API_URL=

# ---- Claude API ----------------------------------------------------------------
# Anthropic key with a spend cap (ai-pipeline §1). Used only by the API service.
ANTHROPIC_API_KEY=
# Optional. Points the SDK at the mock Claude server (packages/ai/src/mock) for local runs.
ANTHROPIC_BASE_URL=

# Optional. Model calls material processing and the Trilha run at once, shared by every material on this server
# (outlines first, then each material's first topics, background work last). Default 24. Raise it only as far as the
# Anthropic account's output-tokens-per-minute limit allows: each call writes about 250 tokens a second.
# AI_WAVE_CONCURRENCY=24

# ---- E-mail (Resend) ----------------------------------------------------------
# Resend API key (resend.com > API Keys). The API sends the guardian verification mail with it; empty: no guardian
# mail. Sign-in codes do not use this variable: Supabase sends them over Resend's SMTP (supabase/config.toml).
RESEND_API_KEY=
# Optional. Sender of the guardian mail; its domain must be verified in Resend.
# MAIL_FROM=Studify <studify@auto.vendua.com.br>

# ---- Podcast voices (packages/speech; D-12 provider still open) -----------------
# google: Google Cloud Text-to-Speech (Neural2 pt-BR) with GOOGLE_TTS_API_KEY. device (default when no key):
# no cloud audio, the app reads episodes and ✋ answers with on-device TTS (INT-01.11).
TTS_PROVIDER=device
GOOGLE_TTS_API_KEY=
# Optional overrides: host voices and the price used for the budget gate (USD per million characters).
# TTS_VOICE_BIA=pt-BR-Neural2-A
# TTS_VOICE_CAIO=pt-BR-Neural2-B
# TTS_USD_PER_MILLION_CHARS=16

# ---- Server operations (inside the API) ------------------------------------------------------
# Expo push sends and receipts. Empty: push is skipped with a warning.
EXPO_ACCESS_TOKEN=
TASK_LOG_LEVEL=info
# Per-attempt Claude timeout for direct server operations, in milliseconds (ai-pipeline §10.2).
AI_TIMEOUT_MS=600000
PG_POOL_MAX=12
