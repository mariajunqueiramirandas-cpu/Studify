# Environment for the backend (docker-compose.yml): read by the api and worker containers.
# Copy to .env for local runs, or paste the same names into Dokploy's Environment tab.
# Every value here is a secret or a deployment setting. Never commit a filled-in .env.

# ---- API (apps/api) ----------------------------------------------------------
# Port inside the container. The image and compose file expect 3000.
PORT=3000
# Public host of the link site and App Links (no scheme). Empty value: custom-scheme links only.
BASE_URL=studify.vendua.com.br
# Optional. Where /download redirects. Default: the newest GitHub Release's studify.apk.
# APK_URL=

# ---- Supabase cloud (Auth, Postgres, Storage, Realtime) ----------------------
# Project URL, for example https://<project-ref>.supabase.co (Project Settings > API).
SUPABASE_URL=
# Secret key (sb_secret_...; the legacy service_role key also works until it is turned off). Server only:
# it bypasses RLS. Never ship it to the mobile app. The variable keeps its name for existing deployments.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_...; the legacy anon key also works until it is turned off). The API uses
# it only to run RPCs as the signed-in user (join_class_group).
SUPABASE_ANON_KEY=

# ---- File storage: Cloudflare R2 (packages/storage) -----------------------------
# Set R2_BUCKET and the three below to keep every file (PDFs, page images, photos, audio, exports) in one R2 bucket.
# Leave them empty to keep files in Supabase Storage (1 GB on the free tier). Both the api and the worker read them.
# R2 dashboard > Manage API tokens: an Object Read & Write token scoped to the bucket (docs/engineering/deployment.md §9).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: r2 | supabase (default: r2 when R2_BUCKET is set). EU-jurisdiction buckets also need R2_ENDPOINT.
# STORAGE_PROVIDER=
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

# ---- Postgres for pg-boss (both services) -------------------------------------
# SESSION pooler connection string (Supavisor, port 5432), not the transaction pooler (6543) and not the
# IPv6-only direct connection. pg-boss needs session mode. Project Settings > Database > Session pooler.
DATABASE_URL=
# Schema pg-boss uses. The worker creates it on first start; both services must use the same name.
PG_BOSS_SCHEMA=pgboss

# ---- Claude API ----------------------------------------------------------------
# Anthropic key with a spend cap (ai-pipeline §1). Used by the API (AI functions) and the worker (jobs).
ANTHROPIC_API_KEY=
# Optional. Points the SDK at the mock Claude server (packages/ai/src/mock) for local runs.
ANTHROPIC_BASE_URL=

# ---- E-mail (Resend) ----------------------------------------------------------
# Resend API key (resend.com > API Keys). The API sends the guardian verification mail with it; empty: no guardian
# mail. Sign-in codes do not use this variable: Supabase sends them over Resend's SMTP (supabase/config.toml).
RESEND_API_KEY=
# Optional. Sender of the guardian mail; its domain must be verified in Resend.
# MAIL_FROM=Studify <studify@auto.vendua.com.br>

# ---- Podcast voices (packages/speech; D-12 provider still open) -----------------
# google: Google Cloud Text-to-Speech (Neural2 pt-BR) with GOOGLE_TTS_API_KEY. device (default when no key):
# no cloud audio, the app reads episodes and ✋ answers with on-device TTS (INT-01.11).
TTS_PROVIDER=device
GOOGLE_TTS_API_KEY=
# Optional overrides: host voices and the price used for the budget gate (USD per million characters).
# TTS_VOICE_BIA=pt-BR-Neural2-A
# TTS_VOICE_CAIO=pt-BR-Neural2-B
# TTS_USD_PER_MILLION_CHARS=16

# ---- Worker (apps/worker) ------------------------------------------------------
# Expo push sends and receipts. Empty: push is skipped with a warning.
EXPO_ACCESS_TOKEN=
WORKER_LOG_LEVEL=info
# Per-attempt Claude timeout for worker jobs, in milliseconds (ai-pipeline §10.2).
AI_TIMEOUT_MS=600000
PG_POOL_MAX=6
