{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/download", "destination": "https://github.com/mariajunqueiramirandas-cpu/Studify/releases/latest/download/studify.apk", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(c|i|q|b)/:id", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] }
  ]
}
