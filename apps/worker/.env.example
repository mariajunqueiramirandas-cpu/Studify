# Worker environment (apps/worker/src/framework/env.ts). Copy to apps/worker/.env and fill in.
# These are secrets: they are read from the process environment only, never from the repo.

# Postgres connection for pg-boss and direct queries. Local Supabase: port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API (local: `supabase status`). The service key is a secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# File storage. Empty: Supabase Storage. Set all four to use Cloudflare R2 (packages/storage, deployment.md §9).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Claude API. Use a dev key with a low spend cap (mobile-app.md §18, ai-pipeline §1).
ANTHROPIC_API_KEY=
# Optional: point the SDK at the mock Claude server in tests and local runs.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8787

# Expo push receipts and sends (framework/push.ts). Without it, push is skipped with a warning.
EXPO_ACCESS_TOKEN=

# ---- Podcast voices (packages/speech; D-12 provider still open) -----------------
# google: Google Cloud Text-to-Speech (Neural2 pt-BR) with GOOGLE_TTS_API_KEY. device (default when no key):
# no cloud audio, the app reads episodes and ✋ answers with on-device TTS (INT-01.11).
TTS_PROVIDER=device
GOOGLE_TTS_API_KEY=
# Optional overrides: host voices and the price used for the budget gate (USD per million characters).
# TTS_VOICE_BIA=pt-BR-Neural2-A
# TTS_VOICE_CAIO=pt-BR-Neural2-B
# TTS_USD_PER_MILLION_CHARS=16

# Optional tuning (defaults shown).
PG_POOL_MAX=6
PG_BOSS_SCHEMA=pgboss
WORKER_LOG_LEVEL=info
AI_TIMEOUT_MS=600000
