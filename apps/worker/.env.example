# Worker environment (apps/worker/src/framework/env.ts). Copy to apps/worker/.env and fill in.
# These are secrets: they are read from the process environment only, never from the repo.

# Postgres connection for pg-boss and direct queries. Local Supabase: port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API (local: `supabase status`).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Claude API. Use a dev key with a low spend cap (mobile-app.md §18, ai-pipeline §1).
ANTHROPIC_API_KEY=
# Optional: point the SDK at the mock Claude server in tests and local runs.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8787

# Expo push receipts and sends (framework/push.ts). Without it, push is skipped with a warning.
EXPO_ACCESS_TOKEN=

# Optional tuning (defaults shown).
PG_POOL_MAX=6
PG_BOSS_SCHEMA=pgboss
WORKER_LOG_LEVEL=info
AI_TIMEOUT_MS=600000
