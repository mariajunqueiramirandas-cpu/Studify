<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 16 Live Updates: material processing, podcasts and corrections as promoted progress. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!-- Re-arms scheduled reminders after a restart (already declared by the app, mobile-app.md §16). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- Priority 0 wins over Expo's service (-1): rich pushes are drawn natively, others go to Expo. -->
    <service
      android:name="com.studify.notify.StudifyMessagingService"
      android:exported="false">
      <intent-filter android:priority="0">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <receiver
      android:name="com.studify.notify.NotifyActionReceiver"
      android:exported="false" />

    <receiver
      android:name="com.studify.notify.NotifyAlarmReceiver"
      android:exported="false" />

    <receiver
      android:name="com.studify.notify.NotifyBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
