# Mobile app environment (mobile-app.md §18). Copy to apps/mobile/.env.development and fill in.
# Only PUBLIC values belong here: Expo bundles every EXPO_PUBLIC_* variable into the APK.
# Never put service keys, Anthropic keys or Sentry auth tokens in this file.

# development | preview | production (app.config.ts uses it for the package and app name)
EXPO_PUBLIC_ENV=development

# Local Supabase (`supabase start`). On the Android emulator use http://10.0.2.2:54321 instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon key printed by `supabase status` (public by design; RLS protects the data).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# HTTPS base for invite links, privacy page and help. Optional: the app falls back to https://studify.app.
# Setting it also enables Android App Links in app.config.ts (D-05).
EXPO_PUBLIC_BASE_URL=

# OAuth web client id for Google sign-in (Google Cloud console, Web application client).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sentry DSN (public ingest URL). Leave empty to disable error reporting in development.
EXPO_PUBLIC_SENTRY_DSN=

# EAS project id (`eas init`). Enables OTA update URLs in app.config.ts; needed for `eas update`.
EXPO_PUBLIC_EAS_PROJECT_ID=
