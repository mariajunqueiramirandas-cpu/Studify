# Edge Functions secrets for local serving. `supabase functions serve` reads supabase/functions/.env.
# Copy to supabase/functions/.env and fill in. Deployed functions use `supabase secrets set --env-file`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the Supabase runtime; do not set them here.

# Claude API key (dev key with a low spend cap). Only Edge Functions and the worker hold it.
ANTHROPIC_API_KEY=
# Optional: mock Claude server for tests and local runs.
ANTHROPIC_BASE_URL=

# Direct Postgres connection used by _shared/prod.ts (local: port 54322).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public host used to build share and invite links (quiz-share, guardian-link). Host only, no scheme:
# normalizeBaseUrl strips https://. Unset: defaults to studify.vendua.com.br (D-05). Set empty to make
# links use the studify:// scheme instead (shareUrl, guardian-link).
BASE_URL=studify.vendua.com.br
